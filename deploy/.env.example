# Copy this file to .env in the same directory before running docker-compose:
#   cp .env.example .env
#
# These values are for local development only. Use strong, unique secrets in staging/production.

MYSQL_ROOT_PASSWORD=dev_root_password_change_me
MYSQL_PASSWORD=dev_app_password_change_me
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars